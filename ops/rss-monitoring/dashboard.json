{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "title": "테크모아 RSS 수집",
  "uid": "techmoa-rss",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "선택 기간에 실패한 블로그 · 실패 횟수",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (blog_id, blog_name) (count_over_time({job=\"techmoa-rss\"} |= \"Failed to collect RSS.\" | regexp `Failed to collect RSS\\. blogId=(?P<blog_id>[0-9]+), blogName=(?P<blog_name>.+)$` | __error__=\"\" [$__range]))",
          "queryType": "instant",
          "maxLines": 48
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "blog_id": "블로그 ID",
              "blog_name": "블로그",
              "Value": "실패 횟수"
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "수집 회차별 전체 · 성공 · 실패",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{job=\"techmoa-rss\"} |= \"RSS collect finished.\" | pattern `<_>RSS collect finished. <summary>` | line_format `{{.summary}}`",
          "queryType": "range",
          "maxLines": 48
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
